# ============================================================
# copee-nest — Production Environment (api.copee.vn)
# Copy file này thành .env trên server rồi điền giá trị thật.
# KHÔNG commit .env. Mọi secret dưới đây phải khác bản dev.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/copee?schema=public"

# --- Server ---
PORT=4000
# Sinh secret mới: openssl rand -base64 48
JWT_SECRET=<production-jwt-secret>

# --- Redis (BullMQ queue: upload ảnh, tạo video) ---
# Bỏ trống = localhost:6379 không mật khẩu
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- URL công khai (callback OAuth + link quay về web) ---
PUBLIC_API_URL=https://api.copee.vn
PUBLIC_WEB_URL=https://app.copee.vn

# --- Telegram bot nạp điểm (admin) ---
# Token lấy từ @BotFather
TELEGRAM_BOT_TOKEN=<token-bot-admin>
# Chat id admin được phép dùng bot (phân tách bằng dấu phẩy). Lấy id bằng cách gửi /start cho bot.
TELEGRAM_ADMIN_IDS=<chat-id>
# (tùy chọn) Channel đăng video khi tạo xong. Bot phải là admin của channel.
# Dạng: -100xxxxxxxxxx (id channel) hoặc @tenchannel. Bỏ trống = gửi cho admin.
TELEGRAM_VIDEO_CHANNEL_ID=
# (tùy chọn) Mức nạp "base:bonus,base:bonus". Bỏ trống = dùng mặc định.
# TELEGRAM_TIERS=10000:0,20000:0,50000:0,100000:0,200000:0,300000:5,500000:15,1000000:20

# --- Bot Telegram RIÊNG cho user tạo video (tách khỏi bot admin) ---
VIDEO_BOT_TOKEN=<token-bot-video>

# --- Gemini / Veo (tạo ảnh + video sản phẩm) ---
# Key phải được bật thanh toán: model ảnh & video không có hạn mức miễn phí.
GEMINI_API_KEY=<gemini-api-key>
# Credit trừ cho mỗi video. Có thể đổi trong trang Admin > Cài đặt mà không cần deploy lại.
VIDEO_COST=5000
# Các biến dưới đây có mặc định trong code, chỉ set khi cần ghi đè:
# VIDEO_ENGINE=omni                          # omni (720p, mặc định) | veo (1080p)
# VIDEO_DIR=uploads/videos                   # thư mục lưu mp4
# OMNI_MODEL=gemini-omni-flash-preview
# VEO_MODEL=veo-3.1-lite-generate-preview
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# AI_CHAT_MODEL=gemini-3.8-flash             # phải là đời 3.x (2.5 không nối chuỗi tool)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# --- Kết nối Facebook fanpage (module social) ---
# Khoá mã hoá access token trước khi lưu DB. ĐỔI KHOÁ NÀY = không giải mã được token cũ.
# Sinh khoá mới: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=1:<base64-key>
ENCRYPTION_ACTIVE_KEY_VERSION=1
# Facebook App (developers.facebook.com). Bỏ trống thì chỉ dùng được cách dán token thủ công.
# Valid OAuth Redirect URI: https://api.copee.vn/social/facebook/callback
META_APP_ID=
META_APP_SECRET=

# --- Lưu trữ ---
# Thư mục lưu ảnh của thư viện ảnh; bỏ trống = <thư mục chạy>/storage/media
# Nên trỏ ra ngoài thư mục deploy để không mất khi build lại.
MEDIA_DIR=/var/lib/copee/media
