# Máy của một số người trong nhóm đang bật legacy-peer-deps=true trong ~/.npmrc.
# Khi đó npm bỏ qua peerDependencies lúc dựng cây phụ thuộc, nên package-lock.json
# sinh ra ở máy đó sẽ khác cây mà CI dựng (CI không có cấu hình cá nhân) và
# `npm ci` báo lock lệch với package.json.
# Ghi rõ ở đây để mọi máy và CI cùng dùng một luật — cấu hình repo đè cấu hình cá nhân.
legacy-peer-deps=false
